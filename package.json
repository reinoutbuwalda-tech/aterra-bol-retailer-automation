{
  "name": "aterra-financial-control-room",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "npm run verify",
    "test:unit": "node --test tests/rendered-html.test.mjs tests/retailer-cloud-extract.test.mjs tests/retailer-foundation-sql.test.mjs tests/retailer-transform.test.mjs skills/bol-retailer-weekly-report/scripts/test-generate-weekly-report.mjs",
    "test:migration": "node --test tests/retailer-migration.integration.test.mjs",
    "test:migration:full-chain": "node --test tests/retailer-full-chain.integration.test.mjs",
    "verify:unit": "npm run lint && npm run build && npm run test:unit",
    "verify": "npm run verify:unit && npm run test:migration && npm run audit:policy",
    "audit:policy": "node scripts/check-npm-audit.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify:benchmark": "node scripts/verify-may-benchmark.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.6.4",
    "@supabase/supabase-js": "2.111.0",
    "jose": "^6.1.3",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.4"
  },
  "type": "module"
}
